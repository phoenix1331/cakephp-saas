UID=1000
GID=1000

# Stripe test-mode credentials (never commit real values to .env).
# Secret key: https://dashboard.stripe.com/test/apikeys
# Webhook secret: run `stripe listen --forward-to localhost:8000/webhooks/stripe`
# and use the whsec_... it prints, or the dashboard's signing secret for a
# configured endpoint.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
